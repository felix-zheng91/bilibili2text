# Copy this file to .env for local Docker Compose deployment. Do not commit .env:
# config.toml may contain API keys and other secrets.

# Public frontend port and backend web-UI access mode (default or open-public).
B2T_FRONTEND_PORT=6010
B2T_WEB_UI_MODE=default
B2T_TIMEZONE=Asia/Shanghai

# ── Login protection ──────────────────────────────────────────────
# The Web UI consumes paid ASR/LLM tokens, so public deployments must enable
# authentication. Setting B2T_AUTH_PASSWORD enables the login gate even when
# B2T_AUTH_ENABLED is omitted; B2T_AUTH_ENABLED=0 disables it explicitly
# (only recommended for local development).
B2T_AUTH_ENABLED=1
B2T_AUTH_USERNAME=admin
# Replace with a long random password. Startup fails when B2T_AUTH_ENABLED=1
# and neither B2T_AUTH_PASSWORD nor B2T_AUTH_PASSWORD_HASH is set.
B2T_AUTH_PASSWORD=
# Optional scrypt hash alternative. Generate one with:
#   docker compose exec backend python -m backend.auth hash
# B2T_AUTH_PASSWORD_HASH=
# Session lifetime in hours (default: 168 = 7 days).
B2T_AUTH_SESSION_HOURS=168
# Optional fixed session signing secret. When empty, a random secret is
# generated once and persisted in db_data/.auth_secret.
# B2T_AUTH_SECRET=


# Backend runtime identity. On Linux, set these to the numeric output of
# `id -u` and `id -g`; Docker Desktop users can keep the defaults.
B2T_UID=1000
B2T_GID=1000

# Optional local image tags used by Docker Compose builds.
B2T_BACKEND_IMAGE=bilibili-to-text:latest
B2T_FRONTEND_IMAGE=bilibili-to-text-web:latest

# Host paths for configuration (mounted read-only) and persistent runtime data.
B2T_CONFIG_PATH=./config.toml
B2T_SUMMARY_PRESETS_PATH=./summary_presets.toml
B2T_CONTEXT_PATH=./context.toml
B2T_TRANSCRIPTIONS_DIR=./transcriptions
B2T_DB_DIR=./db_data
B2T_CHROMA_DIR=./chroma_data
